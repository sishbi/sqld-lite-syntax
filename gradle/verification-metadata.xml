<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pins the sql-psi fork to the exact artefact built from tag 0.9.0 of github.com/sishbi/sql-psi.

  The fork is read from the local Maven repository, so the version alone is not a pin: Gradle does
  not re-resolve a fixed version, and it cannot tell that a `publishToMavenLocal` from a dirty
  working tree has replaced 0.9.0 with something else. The checksum below is what makes the build
  fail instead of quietly using different code.

  Only sishbi.sql-psi is verified. Every other group is trusted by the regex, because listing
  checksums for the whole IntelliJ Platform would need regenerating on each platform bump and would
  not catch anything this build cares about.

  After an intentional change to the fork: tag it, `publishToMavenLocal`, then
      shasum -a 256 ~/.m2/repository/sishbi/sql-psi/core/<version>/core-<version>.jar
  and update the value here along with `sqlPsi` in gradle/libs.versions.toml.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <!-- The .pom and .module of a local publish carry no signature and add nothing to verify. -->
      <verify-metadata>false</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust group="^(?!sishbi\.sql-psi$).*" regex="true"/>
      </trusted-artifacts>
   </configuration>
   <components>
      <component group="sishbi.sql-psi" name="core" version="0.9.0">
         <artifact name="core-0.9.0.jar">
            <sha256 value="e4cc53cfe081ab6b5a7ad5d79a01e2dfb6f2b1f08c7b8302f785314187796fb0"/>
         </artifact>
      </component>
   </components>
</verification-metadata>
