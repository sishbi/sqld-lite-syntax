-- The first link of the migration chain. Every column `BookLoans.sq` reads is declared here, so a
-- name in a query resolves: a table the chain only ever alters declares nothing to resolve to.

CREATE TABLE book_loans (
    loan_id TEXT NOT NULL PRIMARY KEY,
    member_id TEXT NOT NULL,
    branch_name TEXT NOT NULL,
    title TEXT NOT NULL,
    status TEXT NOT NULL,
    created TEXT NOT NULL
);
