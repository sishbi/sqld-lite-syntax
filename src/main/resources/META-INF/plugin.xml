<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>sishbi.sqld-lite-syntax</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>SqlD-Lite Syntax</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/sishbi/sqld-lite-syntax">sishbi</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <p>Syntax highlighting and code navigation for SqlDelight <code>.sq</code> and
        <code>.sqm</code> files. It does the same job as the official SqlDelight plugin with less
        in it. It generates no code; the SqlDelight Gradle plugin does that.</p>

        <ul>
          <li>Highlighting for SQL and for what SqlDelight adds: query labels, <code>:named</code>
              and <code>?</code> bind arguments, imports and <code>AS</code> column types. Every
              colour can be changed under <b>Editor | Color Scheme | SqlDelight</b>.</li>
          <li>PostgreSQL syntax that core SQL rejects, such as <code>ON CONFLICT</code>,
              <code>RETURNING</code>, <code>SELECT DISTINCT ON</code>, window functions, array
              types, <code>GENERATED ALWAYS AS IDENTITY</code>, the <code>::</code> cast, the
              <code>-&gt;&gt;</code> JSON operators and the PostgreSQL <code>ALTER TABLE</code>
              actions. A migration written for PostgreSQL is not painted red.</li>
          <li>Go To Declaration from a Kotlin query call to its query label, from a named argument
              to the bind argument it fills, and from a label to every Kotlin call. It reads an
              index, so it works before you build the project.</li>
          <li>Find Usages on a table, view or column name reports the whole migration chain: the
              <code>CREATE</code>, every <code>ALTER</code> after it and every statement that uses
              it. The same list comes back from any of them, and occurrences in <code>.sql</code>
              files come with it.</li>
          <li>Quick Documentation and cmd-hover on a query, a bind argument or a table, view or
              column name show what it declares.</li>
          <li>A gutter icon on a query label lists the Kotlin calls to it, and an inspection reports
              a query that nothing calls.</li>
        </ul>
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>

    <resource-bundle>messages.SqldLiteMessageBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="SqldLite" language="SqldLite" extensions="sq;sqm"
                  implementationClass="sishbi.sqldlite.SqldLiteFileType" fieldName="INSTANCE"/>
        <lang.parserDefinition language="SqldLite"
                               implementationClass="sishbi.sqldlite.SqldLiteParserDefinition"/>
        <lang.syntaxHighlighterFactory language="SqldLite"
                                       implementationClass="sishbi.sqldlite.SqldLiteSyntaxHighlighterFactory"/>
        <annotator language="SqldLite" implementationClass="sishbi.sqldlite.SqldLiteHighlightAnnotator"/>
        <colorSettingsPage implementation="sishbi.sqldlite.SqldLiteColorSettingsPage"/>
        <iconProvider implementation="sishbi.sqldlite.SqldLiteIconProvider"/>
        <fileBasedIndex implementation="sishbi.sqldlite.SqldLiteLabelIndex"/>
        <gotoDeclarationHandler implementation="sishbi.sqldlite.SqldLiteGotoDeclarationHandler"/>
        <gotoDeclarationHandler implementation="sishbi.sqldlite.SqldLiteSqGotoDeclarationHandler"/>
        <targetElementEvaluator language="SqldLite"
                                implementationClass="sishbi.sqldlite.SqldLiteTargetElementEvaluator"/>
        <lang.findUsagesProvider language="SqldLite"
                                 implementationClass="sishbi.sqldlite.SqldLiteFindUsagesProvider"/>
        <findUsagesHandlerFactory implementation="sishbi.sqldlite.SqldLiteFindUsagesHandlerFactory"/>
        <customUsageSearcher implementation="sishbi.sqldlite.SqldLiteGeneratedQueryUsageSearcher"/>
        <customUsageSearcher implementation="sishbi.sqldlite.SqldLiteSqlFileUsageSearcher"/>
        <usageTypeProvider implementation="sishbi.sqldlite.SqldLiteUsageTypeProvider"/>
        <elementDescriptionProvider implementation="sishbi.sqldlite.SqldLiteElementDescriptionProvider"/>
        <lang.documentationProvider language="SqldLite"
                                    implementationClass="sishbi.sqldlite.SqldLiteDocumentationProvider"/>
        <!-- Registered a second time without a language, for the call-site target: its own
             language is Kotlin, so the registration above never reaches it. -->
        <documentationProvider implementation="sishbi.sqldlite.SqldLiteDocumentationProvider"/>
        <lang.sliceProvider language="SqldLite" implementationClass="sishbi.sqldlite.SqldLiteSliceProvider"/>
        <callHierarchyProvider language="SqldLite"
                               implementationClass="sishbi.sqldlite.SqldLiteCallHierarchyProvider"/>
        <codeInsight.lineMarkerProvider language="SqldLite"
                                        implementationClass="sishbi.sqldlite.SqldLiteCallerLineMarkerProvider"/>
        <localInspection language="SqldLite" shortName="SqldLiteUnusedQuery"
                         bundle="messages.SqldLiteMessageBundle"
                         key="inspection.unused.query.name"
                         groupKey="inspection.group.name"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="sishbi.sqldlite.SqldLiteUnusedQueryInspection"/>
        <stubIndex implementation="com.alecstrong.sql.psi.core.psi.SchemaContributorIndexImpl"/>
        <!-- DevKit reads any attribute named "class" as an implementation class and asks for a
             StubElementTypeHolderEP. This extension point binds "class" as a plain String naming
             the element type holder, so both registrations below are correct as written. -->
        <!--suppress PluginXmlValidity -->
        <stubElementTypeHolder class="com.alecstrong.sql.psi.core.psi.SqlTypes"
                               externalIdPrefix="SqldLite.TYPES"/>
        <!-- The overlay grammar replaces create_index_stmt, which is stub-backed. Without this the
             stub index cannot resolve the element type and every index in the project is lost. -->
        <!--suppress PluginXmlValidity -->
        <stubElementTypeHolder class="sishbi.sqldlite.psi.SqldLiteTypes"
                               externalIdPrefix="SqldLite.OVERLAY"/>
    </extensions>
    <!-- DevKit marks this extension point for removal, saying K2 is now the default. The Plugin
         Verifier still fails a plugin that depends on the Kotlin plugin and omits it, and the
         verifier is the release gate, so it stays until the verifier stops asking. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <!--suppress PluginXmlValidity -->
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>
