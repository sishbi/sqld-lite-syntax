<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>sishbi.sqld-lite-syntax</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>SqlD-Lite Syntax</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/sishbi/sqld-lite-syntax">sishbi</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Syntax highlighting and code navigation for SqlDelight .sq and .sqm files.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>

    <resource-bundle>messages.SqldLiteMessageBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="SqldLite" language="SqldLite" extensions="sq;sqm"
                  implementationClass="sishbi.sqldlite.SqldLiteFileType" fieldName="INSTANCE"/>
        <lang.parserDefinition language="SqldLite"
                               implementationClass="sishbi.sqldlite.SqldLiteParserDefinition"/>
        <lang.syntaxHighlighterFactory language="SqldLite"
                                       implementationClass="sishbi.sqldlite.SqldLiteSyntaxHighlighterFactory"/>
        <annotator language="SqldLite" implementationClass="sishbi.sqldlite.SqldLiteHighlightAnnotator"/>
        <colorSettingsPage implementation="sishbi.sqldlite.SqldLiteColorSettingsPage"/>
        <iconProvider implementation="sishbi.sqldlite.SqldLiteIconProvider"/>
        <fileBasedIndex implementation="sishbi.sqldlite.SqldLiteLabelIndex"/>
        <gotoDeclarationHandler implementation="sishbi.sqldlite.SqldLiteGotoDeclarationHandler"/>
        <gotoDeclarationHandler implementation="sishbi.sqldlite.SqldLiteSqGotoDeclarationHandler"/>
        <targetElementEvaluator language="SqldLite"
                                implementationClass="sishbi.sqldlite.SqldLiteTargetElementEvaluator"/>
        <lang.findUsagesProvider language="SqldLite"
                                 implementationClass="sishbi.sqldlite.SqldLiteFindUsagesProvider"/>
        <findUsagesHandlerFactory implementation="sishbi.sqldlite.SqldLiteFindUsagesHandlerFactory"/>
        <customUsageSearcher implementation="sishbi.sqldlite.SqldLiteGeneratedQueryUsageSearcher"/>
        <customUsageSearcher implementation="sishbi.sqldlite.SqldLiteSqlFileUsageSearcher"/>
        <usageTypeProvider implementation="sishbi.sqldlite.SqldLiteUsageTypeProvider"/>
        <lang.sliceProvider language="SqldLite" implementationClass="sishbi.sqldlite.SqldLiteSliceProvider"/>
        <callHierarchyProvider language="SqldLite"
                               implementationClass="sishbi.sqldlite.SqldLiteCallHierarchyProvider"/>
        <codeInsight.lineMarkerProvider language="SqldLite"
                                        implementationClass="sishbi.sqldlite.SqldLiteCallerLineMarkerProvider"/>
        <localInspection language="SqldLite" shortName="SqldLiteUnusedQuery"
                         bundle="messages.SqldLiteMessageBundle"
                         key="inspection.unused.query.name"
                         groupKey="inspection.group.name"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="sishbi.sqldlite.SqldLiteUnusedQueryInspection"/>
        <stubIndex implementation="com.alecstrong.sql.psi.core.psi.SchemaContributorIndexImpl"/>
        <!-- DevKit reads any attribute named "class" as an implementation class and asks for a
             StubElementTypeHolderEP. This extension point binds "class" as a plain String naming
             the element type holder, so both registrations below are correct as written. -->
        <!--suppress PluginXmlValidity -->
        <stubElementTypeHolder class="com.alecstrong.sql.psi.core.psi.SqlTypes"
                               externalIdPrefix="SqldLite.TYPES"/>
        <!-- The overlay grammar replaces create_index_stmt, which is stub-backed. Without this the
             stub index cannot resolve the element type and every index in the project is lost. -->
        <!--suppress PluginXmlValidity -->
        <stubElementTypeHolder class="sishbi.sqldlite.psi.SqldLiteTypes"
                               externalIdPrefix="SqldLite.OVERLAY"/>
    </extensions>
    <!-- DevKit marks this extension point for removal, saying K2 is now the default. The Plugin
         Verifier still fails a plugin that depends on the Kotlin plugin and omits it, and the
         verifier is the release gate, so it stays until the verifier stops asking. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <!--suppress PluginXmlValidity -->
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>
